# Telegram Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ADMIN_ID="your_telegram_user_id"

# AI/LLM Configuration (Google Gemini)
# Dapatkan API Key gratis dari: https://aistudio.google.com/app/apikey
# Jika dikosongkan, bot akan menggunakan mode deterministik (tanpa AI diskusi interaktif)
LLM_API_KEY="your_google_gemini_api_key_here"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://user:password@localhost/idxagent"

# Application Settings
LOG_LEVEL="INFO"
